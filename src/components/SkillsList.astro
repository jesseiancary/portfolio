---
import { skillGroups } from '../data/site';
---

<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
  {
    skillGroups.map((group) => (
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
          {group.category}
        </h3>
        <ul class="mt-2.5 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-md border border-slate-200 bg-white px-2.5 py-1 text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
