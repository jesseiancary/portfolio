---
import { site, socials } from '../data/site';
---

<header
  class="sticky top-0 z-10 border-b border-slate-200/70 bg-white/80 backdrop-blur dark:border-slate-800/70 dark:bg-slate-950/80"
>
  <nav class="mx-auto flex w-full max-w-5xl items-center justify-between px-5 py-3 sm:px-6">
    <a
      href="/"
      class="font-semibold tracking-tight text-slate-900 transition-colors hover:text-brand-600 dark:text-white dark:hover:text-brand-400"
    >
      {site.header}
    </a>
    <ul class="flex items-center gap-4 text-sm">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="text-slate-600 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
              {...s.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {}}
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
