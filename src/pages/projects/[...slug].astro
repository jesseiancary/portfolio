---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, description, screenshots, videoUrl, githubUrl, liveUrl, tech } =
  project.data;

// Long-form write-up from the Markdown body.
const { Content } = await render(project);
---

<BaseLayout title={`${title} - ${site.name}`} description={description}>
  <article>
    <a
      href="/"
      class="inline-flex items-center gap-1 text-sm text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
    >
      &larr; Back to all projects
    </a>

    <header class="mt-4 mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        {title}
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
        {description}
      </p>

      {
        tech.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {tech.map((t) => (
              <li class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-400">
                {t}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-6 flex flex-wrap gap-3">
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700"
            >
              Visit Live Site &nearr;
            </a>
          )
        }
        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-brand-500 dark:hover:text-brand-400"
            >
              View Source on GitHub
            </a>
          )
        }
      </div>
    </header>

    <Gallery screenshots={screenshots} videoUrl={videoUrl} />

    <div class="prose-project max-w-none text-slate-700 dark:text-slate-300">
      <Content />
    </div>
  </article>
</BaseLayout>
