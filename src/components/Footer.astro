---
import { site, socials } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200/70 dark:border-slate-800/70">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-3 px-5 py-6 text-sm text-slate-500 sm:flex-row sm:px-6 dark:text-slate-400"
  >
    <p>&copy; {year} {site.name}</p>
    <ul class="flex items-center gap-4">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="transition-colors hover:text-brand-600 dark:hover:text-brand-400"
              {...s.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {}}
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
